# Copy the required values into your ignored runtime environment file or export
# them in the shell before invoking Docker Compose. Do not commit real values.
#
# Docker Compose reads .env by default. These variable names intentionally match
# the ASP.NET Core configuration keys used by ai-available-service.

Jwt__Base64SigningKey=
Supabase__Url=
Supabase__ServiceRoleKey=
Supabase__PreviewBucket=ai-place-previews
Supabase__ProtectedAssetBucket=ai-place-protected
StorageUploadToken__Base64SigningKey=
